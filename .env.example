# Copy to .env and adjust. The real .env must never be committed.
DESS_DB_HOST=localhost
DESS_DB_PORT=5433
DESS_DB_NAME=dess
DESS_DB_USER=dess
DESS_DB_PASSWORD=123456

# WildFly installation used by ops/wildfly/*.sh.
WILDFLY_HOME=/tmp/opencode/wildfly-42.0.0.Final

# Optional: PostgreSQL JDBC driver version used by the WildFly module installer.
# POSTGRES_JDBC_VERSION=42.7.7

# Shift WildFly off port 8080 (used by Stremio).
WILDFLY_PORT_OFFSET=100
# BEGIN DESS test accounts (managed by ops/dev/seed-accounts.sh)
DESS_ADMIN_PASSWORD='admin123'
DESS_PROFESSOR_PASSWORD='prof123'
# END DESS test accounts
