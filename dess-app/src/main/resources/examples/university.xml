<?xml version="1.0" encoding="UTF-8"?>
<!-- Exemple A : université. Université > Faculté > Mention > Parcours > Niveau -->
<institution id="institution-001" code="UNIVERSITE_X" name="Université X"
             description="Exemple d'université à cinq niveaux hiérarchiques">

    <unitTypes>
        <type code="UNIVERSITE" label="Université"/>

        <type code="FACULTE" label="Faculté">
            <attributes>
                <attribute key="doyen" label="Doyen" type="TEXT" required="true"/>
                <attribute key="email" label="Adresse e-mail" type="EMAIL" required="false"/>
                <attribute key="telephone" label="Téléphone" type="TEXT" required="false"/>
            </attributes>
        </type>

        <type code="MENTION" label="Mention">
            <attributes>
                <attribute key="chefMention" label="Chef de mention" type="TEXT" required="true"/>
                <attribute key="email" label="Adresse e-mail" type="EMAIL" required="false"/>
                <attribute key="dateCreation" label="Date de création" type="DATE" required="false"/>
                <attribute key="effectifMaximum" label="Effectif maximum" type="NUMBER" required="false"/>
            </attributes>
        </type>

        <type code="PARCOURS" label="Parcours">
            <attributes>
                <attribute key="responsable" label="Responsable du parcours" type="TEXT" required="false"/>
            </attributes>
        </type>

        <type code="NIVEAU" label="Niveau"/>
    </unitTypes>

    <allowedParentChildPairs>
        <allow parent="UNIVERSITE" child="FACULTE"/>
        <allow parent="FACULTE" child="MENTION"/>
        <allow parent="MENTION" child="PARCOURS"/>
        <allow parent="PARCOURS" child="NIVEAU"/>
    </allowedParentChildPairs>

    <units>
        <unit id="univ-x" code="UNIV_X" name="Université X" type="UNIVERSITE" active="true">
            <children>

                <unit id="faculte-droit" code="DROIT" name="Faculté de Droit" type="FACULTE" active="true">
                    <values>
                        <value key="doyen">Rakoto Jean</value>
                        <value key="email">droit@universite.mg</value>
                    </values>
                    <children>
                        <unit id="mention-droit" code="MENTION_DROIT" name="Mention Droit" type="MENTION" active="true">
                            <values>
                                <value key="chefMention">Rabe Marie</value>
                                <value key="dateCreation">2020-01-15</value>
                            </values>
                            <children>
                                <unit id="parcours-droit-prive" code="DROIT_PRIVE" name="Droit privé"
                                      type="PARCOURS" active="true">
                                    <children>
                                        <unit id="droit-prive-l1" code="DROIT_PRIVE_L1" name="Licence 1"
                                              type="NIVEAU" active="true"/>
                                        <unit id="droit-prive-l2" code="DROIT_PRIVE_L2" name="Licence 2"
                                              type="NIVEAU" active="true"/>
                                    </children>
                                </unit>
                            </children>
                        </unit>
                    </children>
                </unit>

                <unit id="faculte-sciences" code="SCIENCES" name="Faculté des Sciences" type="FACULTE" active="true">
                    <values>
                        <value key="doyen">Randria Paul</value>
                        <value key="telephone">+261 20 00 000 00</value>
                    </values>
                    <children>
                        <unit id="mention-informatique" code="MENTION_INFO" name="Mention Informatique"
                              type="MENTION" active="true">
                            <values>
                                <value key="chefMention">Rakoto Jean</value>
                                <value key="email">informatique@universite.mg</value>
                                <value key="dateCreation">2020-01-15</value>
                                <value key="effectifMaximum">500</value>
                            </values>
                            <children>
                                <unit id="parcours-dev" code="PARCOURS_DEV" name="Développement"
                                      type="PARCOURS" active="true">
                                    <values>
                                        <value key="responsable">Andry Rasoa</value>
                                    </values>
                                    <children>
                                        <unit id="dev-l3" code="DEV_L3" name="Licence 3" type="NIVEAU" active="true"/>
                                        <unit id="dev-m1" code="DEV_M1" name="Master 1" type="NIVEAU" active="true"/>
                                    </children>
                                </unit>
                            </children>
                        </unit>
                    </children>
                </unit>

            </children>
        </unit>
    </units>
</institution>
