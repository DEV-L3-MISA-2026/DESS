<?xml version="1.0" encoding="UTF-8"?>
<!--
    WildFly ships JSTL as a server module. The deployment declares the dependency so
    the JSP views can use jakarta.tags.core without bundling a second implementation.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <dependencies>
            <module name="jakarta.servlet.jstl.api"/>
        </dependencies>
    </deployment>
</jboss-deployment-structure>
