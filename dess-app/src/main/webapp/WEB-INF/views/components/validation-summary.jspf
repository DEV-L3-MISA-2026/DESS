<%-- Validation summary. Set validationErrors to the page's Map<String,String>
     of field errors. Each message links to the field whose id equals the map
     key, so servlets must use DOM ids as error keys. A "form" entry is shown
     by the page's own form-level alert and is left out of this list. --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="summaryCount" value="${fn:length(validationErrors)}"/>
<c:if test="${not empty validationErrors.form}">
    <c:set var="summaryCount" value="${summaryCount - 1}"/>
</c:if>
<c:if test="${summaryCount > 0}">
    <div class="flash error" role="alert" tabindex="-1" id="validation-summary">
        <strong>Check the highlighted fields.</strong>
        <ul>
            <c:forEach var="entry" items="${validationErrors}">
                <c:if test="${entry.key != 'form'}">
                    <li><a href="#<c:out value='${entry.key}'/>"><c:out value="${entry.value}"/></a></li>
                </c:if>
            </c:forEach>
        </ul>
    </div>
</c:if>
