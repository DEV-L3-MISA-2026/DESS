<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="peopleTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.people.infrastructure.AppUserEntity</class>
        <class>com.dess.people.infrastructure.StudentEntity</class>
        <class>com.dess.people.infrastructure.TeacherEntity</class>
    </persistence-unit>
    <persistence-unit name="courseTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.academic.infrastructure.CourseEntity</class>
    </persistence-unit>
    <persistence-unit name="academicTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.academic.infrastructure.PeriodEntity</class>
        <class>com.dess.academic.infrastructure.AcademicProgramEntity</class>
        <class>com.dess.academic.infrastructure.ProgramVersionEntity</class>
        <class>com.dess.academic.infrastructure.ProgramEnrollmentEntity</class>
        <class>com.dess.people.infrastructure.AppUserEntity</class>
        <class>com.dess.people.infrastructure.StudentEntity</class>
    </persistence-unit>
    <persistence-unit name="assessmentTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.assessment.infrastructure.AssessmentEntity</class>
        <class>com.dess.assessment.infrastructure.ResultEntity</class>
        <class>com.dess.assessment.infrastructure.ResultCorrectionEntity</class>
    </persistence-unit>
    <persistence-unit name="studentGroupTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.academic.infrastructure.PeriodEntity</class>
        <class>com.dess.academic.infrastructure.StudentGroupEntity</class>
    </persistence-unit>
    <persistence-unit name="dessSchedulingTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.scheduling.infrastructure.persistence.entity.RoomEntity</class>
        <class>com.dess.scheduling.infrastructure.persistence.entity.BookingEntity</class>
        <class>com.dess.scheduling.infrastructure.persistence.entity.BookingSlotEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
    <persistence-unit name="groupEnrollmentTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.dess.academic.infrastructure.GroupEnrollmentEntity</class>
    </persistence-unit>
</persistence>
