<?xml version="1.0" encoding="UTF-8"?>
<!--
    Example C: custom institution (music conservatory).
    Types and relations invented for the occasion, with two roots and one inactive unit:
    the same Java class loads this file without any modification.
-->
<institution id="institution-003" code="CONSERVATOIRE_Z" name="Conservatory Z"
             description="Structure unrelated to a classic school curriculum">

    <unitTypes>
        <type code="CONSERVATOIRE" label="Conservatory"/>

        <type code="POLE" label="Artistic department">
            <attributes>
                <attribute key="directeur" label="Artistic director" type="TEXT" required="true"/>
                <attribute key="budgetAnnuel" label="Annual budget" type="DECIMAL" required="false"/>
            </attributes>
        </type>

        <type code="CLASSE_INSTRUMENT" label="Instrument class">
            <attributes>
                <attribute key="instrument" label="Instrument" type="TEXT" required="true"/>
                <attribute key="ouvertAuxEnfants" label="Open to children" type="BOOLEAN" required="false"
                           default="true"/>
                <attribute key="effectifMax" label="Maximum enrollment" type="NUMBER" required="false"/>
            </attributes>
        </type>

        <type code="ATELIER" label="Ensemble workshop" description="Group practice">
            <attributes>
                <attribute key="ouverture" label="Opening date" type="DATE" required="false"/>
            </attributes>
        </type>

        <type code="ANNEXE" label="Neighbourhood annex"/>
    </unitTypes>

    <allowedParentChildPairs>
        <allow parent="CONSERVATOIRE" child="POLE"/>
        <allow parent="POLE" child="CLASSE_INSTRUMENT"/>
        <allow parent="CLASSE_INSTRUMENT" child="ATELIER"/>
        <allow parent="ANNEXE" child="ATELIER"/>
    </allowedParentChildPairs>

    <units>
        <unit id="cons-z" code="CONS_Z" name="Conservatory Z" type="CONSERVATOIRE">
            <children>
                <unit id="pole-cordes" code="POLE_CORDES" name="Strings department" type="POLE">
                    <values>
                        <value key="directeur">Ravelo Tiana</value>
                        <value key="budgetAnnuel">12500000.50</value>
                    </values>
                    <children>
                        <unit id="classe-violon" code="CL_VIOLON" name="Violin class" type="CLASSE_INSTRUMENT">
                            <values>
                                <value key="instrument">Violin</value>
                                <value key="effectifMax">24</value>
                            </values>
                            <children>
                                <unit id="atelier-quatuor" code="AT_QUATUOR" name="Quartet workshop" type="ATELIER">
                                    <values>
                                        <value key="ouverture">2022-09-01</value>
                                    </values>
                                </unit>
                            </children>
                        </unit>
                    </children>
                </unit>
                <unit id="pole-vents" code="POLE_VENTS" name="Wind department" type="POLE" active="false">
                    <values>
                        <value key="directeur">Rabary Nina</value>
                    </values>
                </unit>
            </children>
        </unit>

        <unit id="annexe-nord" code="ANNEXE_NORD" name="North annex" type="ANNEXE">
            <children>
                <unit id="atelier-percussions" code="AT_PERCU" name="Percussion workshop" type="ATELIER"/>
            </children>
        </unit>
    </units>
</institution>
