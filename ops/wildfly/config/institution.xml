<?xml version="1.0" encoding="UTF-8"?>
<!-- Example B: general high school. School > Education stream > Series > Language > Level -->
<institution id="institution-002" code="LYCEE_Y" name="High School Y">

    <unitTypes>
        <type code="ETABLISSEMENT" label="School">
            <attributes>
                <attribute key="proviseur" label="Principal" type="TEXT" required="true"/>
                <attribute key="siteWeb" label="Website" type="URL" required="false"/>
            </attributes>
        </type>

        <type code="ENSEIGNEMENT" label="Education stream">
            <attributes>
                <attribute key="censeur" label="Deputy head" type="TEXT" required="false"/>
            </attributes>
        </type>

        <type code="SERIE" label="Series">
            <attributes>
                <attribute key="coefficientMax" label="Maximum coefficient" type="DECIMAL" required="false"/>
                <attribute key="selective" label="Selective admission" type="BOOLEAN" required="true" default="false"/>
            </attributes>
        </type>

        <type code="LANGUE" label="Modern language"/>
        <type code="NIVEAU" label="Level"/>
    </unitTypes>

    <allowedParentChildPairs>
        <allow parent="ETABLISSEMENT" child="ENSEIGNEMENT"/>
        <allow parent="ENSEIGNEMENT" child="SERIE"/>
        <allow parent="SERIE" child="LANGUE"/>
        <allow parent="LANGUE" child="NIVEAU"/>
    </allowedParentChildPairs>

    <units>
        <unit id="lycee-y" code="LYCEE_Y_ETAB" name="High School Y" type="ETABLISSEMENT">
            <values>
                <value key="proviseur">Rasoanaivo Hery</value>
                <value key="siteWeb">https://lycee-y.example.mg</value>
            </values>
            <children>
                <unit id="enseignement-general" code="ENS_GENERAL" name="General education" type="ENSEIGNEMENT">
                    <values>
                        <value key="censeur">Razafy Lala</value>
                    </values>
                    <children>
                        <unit id="serie-c" code="SERIE_C" name="Series C" type="SERIE">
                            <values>
                                <value key="coefficientMax">4.5</value>
                                <value key="selective">true</value>
                            </values>
                            <children>
                                <unit id="serie-c-anglais" code="SERIE_C_ANG" name="English" type="LANGUE">
                                    <children>
                                        <unit id="serie-c-anglais-terminale" code="C_ANG_TLE" name="Final year"
                                              type="NIVEAU"/>
                                    </children>
                                </unit>
                            </children>
                        </unit>
                        <unit id="serie-d" code="SERIE_D" name="Series D" type="SERIE">
                            <values>
                                <value key="selective">false</value>
                            </values>
                            <children>
                                <unit id="serie-d-francais" code="SERIE_D_FR" name="French" type="LANGUE"/>
                            </children>
                        </unit>
                    </children>
                </unit>
            </children>
        </unit>
    </units>
</institution>
