<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

  <!-- One persistence unit for the whole monolith. Entities live in the module jars. -->
  <persistence-unit name="dessPU" transaction-type="JTA">
    <jta-data-source>java:jboss/datasources/DessDS</jta-data-source>

    <!-- Paths are relative to WEB-INF/classes; jar names come from outputFileNameMapping in the pom. -->
    <jar-file>../lib/dess-institution.jar</jar-file>
    <jar-file>../lib/dess-people.jar</jar-file>
    <jar-file>../lib/dess-scheduling.jar</jar-file>
    <jar-file>../lib/dess-academic.jar</jar-file>
    <jar-file>../lib/dess-assessment.jar</jar-file>
    <jar-file>../lib/dess-security.jar</jar-file>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>

    <properties>
      <!-- The schema belongs to Flyway, never to Hibernate. -->
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
    </properties>
  </persistence-unit>
</persistence>
